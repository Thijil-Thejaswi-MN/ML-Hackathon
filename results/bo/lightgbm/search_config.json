{
 "model": "lightgbm",
 "n_trials": 40,
 "sampler": "tpe",
 "n_startup_trials": 10,
 "seed": 42,
 "objective": "cv_top1_accuracy",
 "cv": "group_by_trip_frozen_folds",
 "train_obs_frac": 0.3,
 "pruner": "median",
 "enqueue_untuned": true,
 "search_space": {
  "learning_rate": {
   "type": "float",
   "low": 0.01,
   "high": 0.3,
   "log": true,
   "why": "step size; log scale because useful values span 30x"
  },
  "n_estimators": {
   "type": "int",
   "low": 100,
   "high": 1200,
   "step": 50,
   "why": "more trees needed when the learning rate is small"
  },
  "num_leaves": {
   "type": "int",
   "low": 15,
   "high": 255,
   "log": true,
   "why": "main capacity knob of leaf-wise trees"
  },
  "min_child_samples": {
   "type": "int",
   "low": 10,
   "high": 400,
   "log": true,
   "why": "minimum rows per leaf; regularises noisy labels"
  },
  "subsample": {
   "type": "float",
   "low": 0.5,
   "high": 1.0,
   "why": "row bagging per tree reduces variance"
  },
  "colsample_bytree": {
   "type": "float",
   "low": 0.4,
   "high": 1.0,
   "why": "feature subsampling; 37 correlated features"
  },
  "reg_lambda": {
   "type": "float",
   "low": 0.001,
   "high": 10.0,
   "log": true,
   "why": "L2 on leaf values"
  },
  "reg_alpha": {
   "type": "float",
   "low": 0.001,
   "high": 5.0,
   "log": true,
   "why": "L1 on leaf values"
  }
 },
 "base_params": {
  "n_estimators": 400,
  "learning_rate": 0.05,
  "num_leaves": 63,
  "max_depth": -1,
  "min_child_samples": 50,
  "subsample": 0.8,
  "subsample_freq": 1,
  "colsample_bytree": 0.8,
  "reg_alpha": 0.0,
  "reg_lambda": 1.0,
  "is_unbalance": false,
  "random_state": 42,
  "n_jobs": -1
 }
}